{
  "name": "toge",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  // Workers Logs: exceptions, Durable Object resets and limit errors show up in the dashboard (Observability), so a
  // dropped race can be traced. Free plan: 200k log events a day, plenty for a group of friends.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    // The router uses history paths, so unknown paths serve index.html. The worker only runs for the game endpoints.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RACE", "class_name": "RaceRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  // SQLite-backed classes are the ones available on the free plan. A new Worker, so one fresh migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Accounts", "RaceRoom"] }],
  // Branch previews (`wrangler preview`): each gets its own isolated Durable Objects (3 namespaces per preview, counted
  // against the account's 100 on the free plan). The code reads them from `env`, so the bindings are repeated here.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "RACE", "class_name": "RaceRoom" },
        { "name": "DIRECTORY", "class_name": "Directory" },
        { "name": "ACCOUNTS", "class_name": "Accounts" }
      ]
    }
  }
}
