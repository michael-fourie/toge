{
  "name": "atrous",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // The router uses history paths, so unknown paths serve index.html. The worker only runs for the game endpoints.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "LobbyRoom" },
      { "name": "RACE", "class_name": "RaceRoom" },
      { "name": "PARTY", "class_name": "PartyRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  // SQLite-backed classes are the ones available on the free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LobbyRoom", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v3", "new_sqlite_classes": ["RaceRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["PartyRoom"] }
  ],
  // Branch previews (`wrangler preview`): each gets its own isolated Durable Objects. The code reads them from `env`,
  // so the bindings are repeated here or they don't exist in a preview.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "LOBBY", "class_name": "LobbyRoom" },
        { "name": "RACE", "class_name": "RaceRoom" },
        { "name": "PARTY", "class_name": "PartyRoom" },
        { "name": "DIRECTORY", "class_name": "Directory" },
        { "name": "ACCOUNTS", "class_name": "Accounts" }
      ]
    }
  }
}
